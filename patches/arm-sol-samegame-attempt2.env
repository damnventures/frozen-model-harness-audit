# Same-game second attempt with the model's OWN notes (composer §373, launched on the lead's word 10-31 22:5xZ):
# GPT-6.1 Sol replays the five screen games it played on 10-31 (writer-fixed run 20261031_120359), seeded with the cards it
# wrote about each game on attempt 1 (seed keys '<game>-attempt1', so cross_game.read_cards does not hide them as the own key).
# Control = the same-day cold run 20261031_110022_sol-cards-off-5g-v3 (Sol holds nothing across runs, so a cold attempt is a cold attempt).
# Settings = arm-sol-cards-on.env exactly (OpenRouter path, ARC3_CARD_THINKING=1 = the writer fix), plus the seed.
export LOCAL_ANALYZER_API_KEY="$(cat /Users/vanya/work/arc/.secrets/openrouter_key)"
export LOCAL_ANALYZER_BASE_URL="https://openrouter.ai/api/v1"
export LOCAL_ANALYZER_PROVIDER="openrouter"
export MODEL_ID="openai/gpt-6.1-sol"
export LOCAL_ANALYZER_MODEL_ID="openai/gpt-6.1-sol"
export ARC3_CARD_THINKING=1
export ARC3_CROSS_GAME=1
export ARC3_CROSS_GAME_CARD=call
export ARC3_CROSS_GAME_SEED=/Users/vanya/work/arc/runs/field/ours/deploy/seeds-sol-attempt1.jsonl
export ARC3_CROSS_GAME_MAX_CHARS=7000
