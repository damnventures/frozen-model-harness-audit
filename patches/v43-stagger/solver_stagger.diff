+def _stagger_delay_s(game_id: str, index: int) -> float:
+    """§348a two-wave form without a second run: games named in ARC3_START_DELAY_GAMES (comma list of game-id
+    prefixes) or, with ARC3_START_DELAY_HALF=1, every odd index, sleep ARC3_START_DELAY_S seconds AFTER their
+    per-game wall timer has started, then play. They lose that much wall; the games already playing get the
+    throughput meanwhile; the run's end does not move. At session start they read the cards the first half wrote."""
+    try:
+        delay = float(os.environ.get("ARC3_START_DELAY_S", "0") or 0)
+    except ValueError:
+        return 0.0
+    if delay <= 0:
+        return 0.0
+    names = [g for g in os.environ.get("ARC3_START_DELAY_GAMES", "").split(",") if g]
+    if names:
+        return delay if any(str(game_id).startswith(g) for g in names) else 0.0
+    if os.environ.get("ARC3_START_DELAY_HALF", "").strip() == "1":
+        return delay if index % 2 == 1 else 0.0
+    return 0.0
+
